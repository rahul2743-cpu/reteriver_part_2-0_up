# ==========================================================
# CELL 18 - CONTEXT BUILDING + LLM ANSWER
#
#   top_chunks (Cell 17)  +  relationships (edges, Cell 16)
#        -> numbered context  [1] [2] ... within MAX_CONTEXT_CHARS
#        -> LLM answers ONLY from the context, citing [n]
#        -> citation check  -> answer + sources
#
# Needs: llm (Cell 12), get_subgraph + rank_chunks (Cell 17)
# ==========================================================
import re
import pandas as pd

print("=" * 80)
print("CELL 18 - CONTEXT BUILDING + LLM ANSWER")
print("=" * 80)

# ----------------------------------------------------------
# CONFIG
# ----------------------------------------------------------
MAX_CONTEXT_CHARS     = 14000   # total size of the context sent to the LLM
INCLUDE_RELATIONSHIPS = True    # add knowledge-graph facts above the excerpts
MAX_RELATIONSHIPS     = 15
MAX_REL_CHARS         = 3000    # relationships may use at most this much of the budget

ANSWER_SYSTEM_PROMPT = """You answer questions about technical documentation.

Use ONLY the CONTEXT below. It contains numbered DOCUMENT EXCERPTS [1], [2], ...
and, optionally, RELATIONSHIPS from a knowledge graph.

Rules:
- Answer only with information found in the context. Do not use outside knowledge.
- After every sentence that uses an excerpt, cite it with its number, e.g. [1] or [2][3].
- Relationships are supporting facts; cite the excerpt that supports a claim when possible.
- If the context does not contain the answer, reply exactly:
  "The provided documents do not contain enough information to answer this question."
- Be concise and specific."""

NO_ANSWER = "The provided documents do not contain enough information to answer this question."


# ----------------------------------------------------------
# STEP 1 : BUILD THE CONTEXT
# ----------------------------------------------------------
def build_context(top_chunks, edges):
    """Returns (context_text, sources).
    sources = one row per numbered excerpt actually placed in the context."""

    # --- relationships: only edges touching the selected documents ---
    rel_lines, rel_used = [], 0
    if INCLUDE_RELATIONSHIPS and edges:
        selected_docs = {c["doc"] for c in top_chunks}
        related = [e for e in edges
                   if e["source"] in selected_docs or e["target"] in selected_docs]
        related.sort(key=lambda e: (-e["strength"], e["hop"]))
        seen = set()
        for e in related:
            key = (e["source_label"], e["predicate"], e["target_label"])
            if key in seen:
                continue
            seen.add(key)
            line = (f"- {e['source_label']} --[{e['predicate']}]--> "
                    f"{e['target_label']}: {e['description']}")
            if rel_used + len(line) + 1 > MAX_REL_CHARS or len(rel_lines) >= MAX_RELATIONSHIPS:
                break
            rel_lines.append(line)
            rel_used += len(line) + 1

    # --- numbered excerpts, in Cell 17's BM25 order, within the budget ---
    budget = MAX_CONTEXT_CHARS - rel_used
    blocks, sources, used = [], [], 0
    for c in top_chunks:
        n = len(blocks) + 1
        block = f"[{n}] (source: {c['title']})\n{c['text']}"
        if used + len(block) + 2 > budget:
            break
        blocks.append(block)
        used += len(block) + 2
        sources.append({
            "ref": n,
            "title": c["title"],
            "chunk_id": c["chunk_id"],
            "bm25": round(c["bm25"], 4),
        })

    parts = ["DOCUMENT EXCERPTS:\n" + "\n\n".join(blocks)]
    if rel_lines:
        parts.insert(0, "RELATIONSHIPS:\n" + "\n".join(rel_lines))
    return "\n\n".join(parts), sources


# ----------------------------------------------------------
# STEP 2 : CHECK THE CITATIONS IN THE ANSWER
# ----------------------------------------------------------
def check_citations(answer, sources):
    """Which [n] the answer cites, and whether any cite a number
    that does not exist in the context."""
    cited = sorted({int(n) for n in re.findall(r"\[(\d+)\]", answer)})
    valid = {s["ref"] for s in sources}
    return {
        "cited": cited,
        "invalid": [n for n in cited if n not in valid],
        "uncited_answer": (not cited) and answer.strip() != NO_ANSWER,
    }


# ----------------------------------------------------------
# STEP 3 : FULL PIPELINE  question -> answer
# ----------------------------------------------------------
def answer_question(question):
    phrases, seeds, edges, visited = get_subgraph(question)                  # Cell 15 + 16
    top_chunks, doc_ranking = rank_chunks(question, phrases, seeds, edges)   # Cell 17

    if not top_chunks:
        return {"question": question, "answer": NO_ANSWER, "sources": [],
                "context": "", "doc_ranking": doc_ranking, "seeds": seeds,
                "citations": {"cited": [], "invalid": [], "uncited_answer": False}}

    context, sources = build_context(top_chunks, edges)

    resp = llm.invoke([
        {"role": "system", "content": ANSWER_SYSTEM_PROMPT},
        {"role": "user", "content": f"CONTEXT:\n{context}\n\nQUESTION: {question}"},
    ])
    answer = resp.content if isinstance(resp.content, str) else str(resp.content)

    return {
        "question": question,
        "answer": answer.strip(),
        "sources": sources,
        "context": context,
        "doc_ranking": doc_ranking,
        "seeds": seeds,
        "citations": check_citations(answer, sources),
    }


# ----------------------------------------------------------
# RUN FOR A QUESTION
# ----------------------------------------------------------
QUERY = "What is meant by service operation in the context of Rolls-Royce product?"   # <- type your question here

result = answer_question(QUERY)

print(f"QUESTION : {result['question']}")
print()
print("ANSWER   :")
print(result["answer"])
print()
print(f"Context  : {len(result['context'])} chars (budget {MAX_CONTEXT_CHARS}), "
      f"{len(result['sources'])} excerpts")

cit = result["citations"]
print(f"Cited    : {cit['cited'] or 'none'}")
if cit["invalid"]:
    print(f"WARNING  : answer cites excerpts that do not exist: {cit['invalid']}")
if cit["uncited_answer"]:
    print("WARNING  : answer has no citations - check it is grounded in the context")

print()
print("SOURCES:")
if result["sources"]:
    src_df = pd.DataFrame(result["sources"])
    src_df["cited"] = src_df["ref"].isin(cit["cited"])
    display(src_df[["ref", "title", "bm25", "cited", "chunk_id"]])
else:
    print("  none")
