# ==============================================================================
# CELL 17A - RETRIEVE & RANK CHUNKS  (subgraph -> documents -> chunks -> PageRank)
# ==============================================================================
#   A1. Pick the documents in the query sub-graph
#       (seed docs + parent docs of entity seeds + hop-1/hop-2 docs + inline links)
#   A2. Fetch their content (one SPARQL call per batch)
#   A3. Chunk each document (cached, so each document is chunked only once)
#   A4. For EACH document: standard PageRank over a graph of its chunks + the
#       query words -> keep the best CHUNKS_PER_DOC (3-4)
#   A5. Standard PageRank over ALL kept chunks + the KG sub-graph
#       -> final chunk score = PageRank
#   Ranking = standard PageRank only:  PR(i) = (1-d)/N + d * SUM PR(j)/L(j)
#   computed iteratively until the scores stop changing.
#
# Main function:  retrieve_chunks(question, verbose=True) -> dict
# Needs from earlier cells: g, PREFIXES, CONTENT_NODES, NODE_LABEL,
#   LABEL_TO_NODES, DOC_CONTENT_TMPL, extract_query_entities (Cell 15),
#   link_entities, traverse, content_search, lexical_fallback (Cell 16)
# ==============================================================================
import math
import re
from collections import defaultdict, Counter

print("=" * 80)
