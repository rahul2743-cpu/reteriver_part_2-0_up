_REQ_17A = ["g", "PREFIXES", "CONTENT_NODES", "NODE_LABEL", "LABEL_TO_NODES",
            "DOC_CONTENT_TMPL", "extract_query_entities", "link_entities",
            "traverse", "content_search", "lexical_fallback"]
