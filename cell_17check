# ==============================================================================
# CELL 17B-INPUT : show EXACTLY what is sent to the LLM for one question
# (run after Cell 17A and 17B; change QUESTION and run again)
# ==============================================================================
QUESTION = "What actions can a Chief Development Engineer perform when managing experiments?"

res = kg_answer(QUESTION, verbose=False)
ctx = res["context"]
user_msg = f"{ctx}\n\n---QUESTION---\n{QUESTION}"

def line(t):
    print("\n" + "=" * 90 + f"\n{t}\n" + "=" * 90)

# ---- 1. what was chosen -------------------------------------------------------
line(f"1. CHUNKS CHOSEN: {len(res['top_chunks'])} (K={res['k']})")
for i, c in enumerate(res["top_chunks"], 1):
    print(f"  {i}. score={c['score']:.3f}  {c['doc_label'][:60]}  (chunk #{c['index']}, {len(c['text'])} chars)")

# ---- 2. message 1 = SYSTEM (rules) -------------------------------------------
line(f"2. MESSAGE 1 - SYSTEM (rules): {len(ANSWER_PROMPT)} chars")
print(ANSWER_PROMPT)

# ---- 3. message 2 = USER (context + question) --------------------------------
line(f"3. MESSAGE 2 - USER (context + question): {len(user_msg)} chars")
print(user_msg)

# ---- 4. size summary -----------------------------------------------------------
total = len(ANSWER_PROMPT) + len(user_msg)
line("4. SIZE SENT TO THE LLM")
print(f"  text blocks [C#]   : {ctx.count(chr(10) + '[C')}")
print(f"  relationships [R#] : {ctx.count(chr(10) + '[R')}")
print(f"  context            : {len(ctx)} chars  (limit {MAX_CONTEXT_CHARS})")
print(f"  total (system+user): {total} chars  (~{total // 4} tokens)")
if "(none)" in ctx.split("### RELATIONSHIPS")[0]:
    print("  WARNING: no document text was sent -> retrieval found nothing (Cell 16/17A)")

# ---- 5. what came back ---------------------------------------------------------
line("5. LLM OUTPUT")
print("raw (with IDs) :\n" + res.get("raw_answer", res["answer"]))
print("\nclean (user)   :\n" + res["answer"])
print("\ncited IDs      :", res["cited"], "   invented IDs:", res["invalid_ids"] or "none")
print("sources        :")
for s in res["sources"]:
    print("  -", s["title"] if isinstance(s, dict) else s)
