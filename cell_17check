import re, time
import pandas as pd

TESTS = [
    {"q": "What actions can a Chief Development Engineer perform when managing experiments?",
     "expect": ["approve", "experiment"]},
    {"q": "What is HITCH used for?",                      "expect": ["sign"]},
    {"q": "How do I book a rocket to the moon?",          "expect": []},     # not in wiki
    # add your own questions here ...
]
NOT_FOUND = ["do not contain", "not found in the provided documents"]

def check_one(t):
    t0 = time.time()
    res = kg_answer(t["q"], verbose=False)
    ans, ctx = res["answer"], res["context"]
    body = ans.split("Sources:")[0].replace("Answer:", "")
    sent = [s for s in re.split(r"(?<=[.!?])\s+", body) if len(s.strip()) > 20]
    uncited = [s for s in sent if not re.search(r"\[[CR]\d+\]", s)
               and not any(p in s.lower() for p in NOT_FOUND)]
    says_nf = any(p in ans.lower() for p in NOT_FOUND)
    if t["expect"]:
        missing  = [w for w in t["expect"] if w.lower() not in ans.lower()]
        in_ctx   = all(w.lower() in ctx.lower() for w in t["expect"])
        correct  = not missing
    else:                                   # wiki has no answer -> must refuse
        missing, in_ctx, correct = [], True, says_nf
    ok = correct and not res["invalid_ids"] and not uncited and len(ctx) <= MAX_CONTEXT_CHARS + 100
    return {"question": t["q"][:60], "K": res["k"], "chunks": len(res["top_chunks"]),
            "ctx_chars": len(ctx), "cited": len(res["cited"]), "invalid": len(res["invalid_ids"]),
            "uncited": len(uncited), "found_in_ctx": in_ctx, "missing_words": ",".join(missing),
            "correct": correct, "PASS": ok, "sec": round(time.time() - t0, 1),
            "_res": res}

rows = [check_one(t) for t in TESTS]
df = pd.DataFrame([{k: v for k, v in r.items() if k != "_res"} for r in rows])
pd.set_option("display.width", 200); pd.set_option("display.max_columns", 20)
print(df.to_string(index=False))

n = len(df)
print(f"\nPASSED            : {df.PASS.sum()}/{n}")
print(f"correct answers   : {df.correct.sum()}/{n}")
print(f"invented IDs      : {df.invalid.sum()}   uncited sentences: {df.uncited.sum()}")
print(f"avg context       : {df.ctx_chars.mean():.0f} chars (~{df.ctx_chars.mean()/4:.0f} tokens)")

