# ==========================================================
# CELL 18-DEBUG : STEP-BY-STEP TRACE OF CELL 18
#
# Runs Cell 18 for ONE question and prints what happens at every stage.
# It only READS - it does not change anything Cell 17 or Cell 18 built.
#
#   1. retrieval input   (top chunks from Cell 17)
#   2. relationships     (which edges went in, which were cut and why)
#   3. excerpts          (which chunks went in, budget used)
#   4. full context      (exactly what the LLM reads)
#   5. prompt size       (characters / approx. tokens)
#   6. LLM answer        (raw answer + time taken)
#   7. citation check    (per sentence: cited? which excerpts?)
#   8. cross-check       (debug context == Cell 18 build_context?)
#
# Needs: Cell 17 + Cell 18 already run (get_subgraph, rank_chunks, _terms,
#        build_context, check_citations, ANSWER_SYSTEM_PROMPT, NO_ANSWER,
#        MAX_CONTEXT_CHARS, INCLUDE_RELATIONSHIPS, MAX_RELATIONSHIPS,
#        MAX_REL_CHARS), llm (Cell 12)
# ==========================================================
import re
import time
import pandas as pd
from collections import Counter

DEBUG_QUERY       = "What is meant by service operation in the context of Rolls-Royce product?"  # <- question to trace
SHOW_TEXT         = 150     # characters of chunk text shown in tables
PRINT_FULL_CONTEXT = True   # print the whole context sent to the LLM
CALL_LLM          = True    # False = trace the context only, no LLM call

pd.set_option("display.max_colwidth", SHOW_TEXT)


def _show(df, title):
    print(f"\n--- {title} ({len(df)} rows) ---")
    if len(df):
        display(df)
    else:
        print("  (empty)")


def _header(t):
    print("\n" + "=" * 80)
    print(t)
    print("=" * 80)


def debug_cell18(question):
    print("=" * 80)
    print("CELL 18-DEBUG")
    print("=" * 80)
    print(f"QUESTION : {question}")

    # ------------------------------------------------------
    # 1. RETRIEVAL INPUT  (Cell 17)
    # ------------------------------------------------------
    _header("1. RETRIEVAL INPUT  (Cell 17: get_subgraph + rank_chunks)")
    phrases, seeds, edges, visited = get_subgraph(question)
    top_chunks, doc_ranking = rank_chunks(question, phrases, seeds, edges)
    print(f"phrases : {phrases}")
    print(f"seeds   : {len(seeds)}   edges : {len(edges)}   top chunks : {len(top_chunks)}")
    _show(pd.DataFrame([{
        "order": i + 1, "title": c["title"], "chunk_index": c["chunk_index"],
        "bm25": round(c["bm25"], 4), "chars": len(c["text"]),
        "text": c["text"][:SHOW_TEXT],
    } for i, c in enumerate(top_chunks)]), "top chunks handed to Cell 18 (BM25 order)")

    if not top_chunks:
        print("\nNo chunks -> Cell 18 returns the fixed reply without calling the LLM:")
        print(f"  {NO_ANSWER}")
        return

    # ------------------------------------------------------
    # 2. RELATIONSHIPS  (same rules as build_context)
    # ------------------------------------------------------
    _header(f"2. RELATIONSHIPS  (INCLUDE={INCLUDE_RELATIONSHIPS}, "
            f"max {MAX_RELATIONSHIPS} lines, max {MAX_REL_CHARS} chars)")
    rel_lines, rel_used, rel_rows = [], 0, []
    selected_docs = {c["doc"] for c in top_chunks}
    if INCLUDE_RELATIONSHIPS and edges:
        related = [e for e in edges
                   if e["source"] in selected_docs or e["target"] in selected_docs]
        print(f"edges total : {len(edges)}   touching the selected documents : {len(related)}   "
              f"ignored (not touching) : {len(edges) - len(related)}")
        related.sort(key=lambda e: (-e["strength"], e["hop"]))
        seen, stopped = set(), False
        for e in related:
            key = (e["source_label"], e["predicate"], e["target_label"])
            line = (f"- {e['source_label']} --[{e['predicate']}]--> "
                    f"{e['target_label']}: {e['description']}")
            if stopped:
                status = "not reached (limit hit)"
            elif key in seen:
                status = "duplicate"
            elif rel_used + len(line) + 1 > MAX_REL_CHARS:
                status, stopped = "cut (MAX_REL_CHARS)", True
            elif len(rel_lines) >= MAX_RELATIONSHIPS:
                status, stopped = "cut (MAX_RELATIONSHIPS)", True
            else:
                status = "INCLUDED"
                seen.add(key)
                rel_lines.append(line)
                rel_used += len(line) + 1
            rel_rows.append({"status": status, "strength": e["strength"], "hop": e["hop"],
                             "source": e["source_label"], "predicate": e["predicate"],
                             "target": e["target_label"], "chars": len(line)})
        _show(pd.DataFrame(rel_rows), "relationship decisions (strongest first)")
    else:
        print("relationships switched off or no edges")
    print(f"relationship chars used : {rel_used} of {MAX_REL_CHARS}")

    # ------------------------------------------------------
    # 3. EXCERPTS  (same rules as build_context)
    # ------------------------------------------------------
    budget = MAX_CONTEXT_CHARS - rel_used
    _header(f"3. EXCERPTS  (budget = {MAX_CONTEXT_CHARS} - {rel_used} relationships = {budget} chars)")
    blocks, sources, used, ex_rows, stopped = [], [], 0, [], False
    for c in top_chunks:
        n = len(blocks) + 1
        block = f"[{n}] (source: {c['title']})\n{c['text']}"
        if stopped or used + len(block) + 2 > budget:
            stopped = True
            ex_rows.append({"ref": "-", "status": "cut (budget)", "title": c["title"],
                            "chars": len(block), "running_total": used})
            continue
        blocks.append(block)
        used += len(block) + 2
        sources.append({"ref": n, "title": c["title"], "chunk_id": c["chunk_id"],
                        "bm25": round(c["bm25"], 4)})
        ex_rows.append({"ref": n, "status": "INCLUDED", "title": c["title"],
                        "chars": len(block), "running_total": used})
    _show(pd.DataFrame(ex_rows), "excerpt decisions (BM25 order)")
    print(f"excerpt chars used : {used} of {budget}")

    parts = ["DOCUMENT EXCERPTS:\n" + "\n\n".join(blocks)]
    if rel_lines:
        parts.insert(0, "RELATIONSHIPS:\n" + "\n".join(rel_lines))
    context = "\n\n".join(parts)

    # ------------------------------------------------------
    # 4. FULL CONTEXT
    # ------------------------------------------------------
    _header(f"4. FULL CONTEXT  ({len(context)} chars, budget {MAX_CONTEXT_CHARS})")
    if PRINT_FULL_CONTEXT:
        print(context)
    else:
        print(context[:1500] + ("\n... (truncated)" if len(context) > 1500 else ""))

    # ------------------------------------------------------
    # 5. PROMPT SIZE
    # ------------------------------------------------------
    _header("5. PROMPT SIZE")
    user_msg = f"CONTEXT:\n{context}\n\nQUESTION: {question}"
    total = len(ANSWER_SYSTEM_PROMPT) + len(user_msg)
    print(f"system prompt : {len(ANSWER_SYSTEM_PROMPT):6d} chars")
    print(f"user message  : {len(user_msg):6d} chars")
    print(f"total         : {total:6d} chars  (~{total // 4} tokens, rough estimate 4 chars/token)")

    # ------------------------------------------------------
    # 8 (run early, no LLM needed). CROSS-CHECK WITH build_context
    # ------------------------------------------------------
    real_context, real_sources = build_context(top_chunks, edges)
    same = (real_context == context and
            [s["chunk_id"] for s in real_sources] == [s["chunk_id"] for s in sources])

    if not CALL_LLM:
        _header("6-7. LLM CALL SKIPPED  (CALL_LLM = False)")
    else:
        # --------------------------------------------------
        # 6. LLM ANSWER
        # --------------------------------------------------
        _header("6. LLM ANSWER")
        t0 = time.time()
        resp = llm.invoke([
            {"role": "system", "content": ANSWER_SYSTEM_PROMPT},
            {"role": "user", "content": user_msg},
        ])
        secs = time.time() - t0
        answer = (resp.content if isinstance(resp.content, str) else str(resp.content)).strip()
        print(f"time : {secs:.1f} s")
        print()
        print(answer)

        # --------------------------------------------------
        # 7. CITATION CHECK  (per sentence)
        # --------------------------------------------------
        _header("7. CITATION CHECK")
        cit = check_citations(answer, sources)
        print(f"cited excerpts  : {cit['cited'] or 'none'}")
        print(f"invalid numbers : {cit['invalid'] or 'none'}")
        print(f"answer uncited  : {cit['uncited_answer']}")
        if answer == NO_ANSWER:
            print("LLM said the context does not contain the answer.")

        by_ref = {s["ref"]: s for s in sources}
        text_by_ref = {i + 1: top_chunks[i]["text"] for i in range(len(sources))}
        sent_rows = []
        for sent in [s for s in re.split(r"(?<=[.!?])\s+", answer) if s.strip()]:
            refs = [int(r) for r in re.findall(r"\[(\d+)\]", sent)]
            words = set(_terms(re.sub(r"\[\d+\]", "", sent)))
            cited_text = " ".join(text_by_ref.get(r, "") for r in refs)
            overlap = (len(words & set(_terms(cited_text))) / len(words)) if (words and refs) else None
            sent_rows.append({
                "sentence": sent[:SHOW_TEXT],
                "cites": refs or "-",
                "cited_titles": ", ".join(by_ref[r]["title"] for r in refs if r in by_ref) or "-",
                "word_overlap_with_cited": None if overlap is None else round(overlap, 2),
            })
        _show(pd.DataFrame(sent_rows),
              "per sentence (word_overlap = share of the sentence's words found in the cited "
              "excerpts; rough check, low values deserve a look)")

        used_titles = Counter(by_ref[r]["title"] for r in cit["cited"] if r in by_ref)
        _show(pd.DataFrame([{
            "ref": s["ref"], "title": s["title"], "bm25": s["bm25"],
            "cited": s["ref"] in cit["cited"],
        } for s in sources]), "sources (was each excerpt used?)")
        print(f"documents cited : {dict(used_titles) or 'none'}")

    # ------------------------------------------------------
    # 8. CROSS-CHECK RESULT
    # ------------------------------------------------------
    _header("8. CROSS-CHECK  (debug context vs Cell 18 build_context)")
    if same:
        print("OK - debug trace built exactly the same context and sources as build_context.")
    else:
        print("MISMATCH - debug trace and build_context differ "
              f"(debug {len(context)} chars, build_context {len(real_context)} chars).")


debug_cell18(DEBUG_QUERY)

