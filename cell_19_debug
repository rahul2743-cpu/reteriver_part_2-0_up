print("=" * 80)
all_docs = sorted((n for n in dbg_ppr if n in CHUNKS_BY_DOC), key=lambda n: -dbg_ppr[n])
kept_docs = all_docs[:MAX_DOCS]
_show(pd.DataFrame([{
    "rank": i + 1, "title": _label(d), "ppr": round(dbg_ppr[d], 5),
    "chunks": len(CHUNKS_BY_DOC[d]),
    "status": "KEPT" if d in kept_docs else "cut (beyond MAX_DOCS)",
} for i, d in enumerate(all_docs)]), "documents in the subgraph")

# ----------------------------------------------------------
# 6. QUERY TERMS
