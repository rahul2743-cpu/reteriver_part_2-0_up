    "is_document": n in CHUNKS_BY_DOC,
    "drives_traversal": n in CONTENT_NODES,
    "node": n,
} for n, lab, sc, p in dbg_seeds]), "2b. FINAL SEEDS")

if dbg_seeds and not any(n in CONTENT_NODES for n, *_ in dbg_seeds):
    print("  WARNING: no seed is a document -> traversal will find no edges.")

# ----------------------------------------------------------
# 3. TRAVERSAL
# ----------------------------------------------------------
print("\n" + "=" * 80)
print("3. TRAVERSAL  (Cell 16 traverse, outgoing edges, 2 hops)")
print("=" * 80)
dbg_edges, dbg_visited = traverse(dbg_seeds)

hop_counts = Counter(e["hop"] for e in dbg_edges)
print(f"edges total : {len(dbg_edges)}   hop1 = {hop_counts.get(1, 0)}   hop2 = {hop_counts.get(2, 0)}")
print(f"nodes visited : {len(dbg_visited)}")

_show(pd.DataFrame([{
    "hop": e["hop"], "source": e["source_label"], "predicate": e["predicate"],
    "target": e["target_label"], "strength": e["strength"],
} for e in dbg_edges]), "edges")

pred_counts = Counter(e["predicate"] for e in dbg_edges)
_show(pd.DataFrame(pred_counts.most_common(), columns=["predicate", "count"]),
      "predicate check (names should be real relationships, not 'Statement'/'type'/text)")

# ----------------------------------------------------------
# 4. PERSONALIZED PAGERANK
