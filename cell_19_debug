# 2a. per-phrase view (for reading only)
rows = []
for phrase, cls in dbg_phrases:
    hits = link_entities([(phrase, cls)])
    if not hits:
        rows.append({"phrase": phrase, "node_label": "-- no link --", "score": None})
    for n, lab, sc, _p in hits:
        rows.append({"phrase": phrase, "node_label": lab, "score": sc})
_show(pd.DataFrame(rows), "2a. link_entities per phrase (95 = exact, 80 = token, other = fuzzy)")

# 2b. exactly what get_subgraph does
dbg_seeds = link_entities(dbg_phrases) if dbg_phrases else []
linked = {s[3] for s in dbg_seeds}
added_cs = []
for phrase, _cls in dbg_phrases:
    if phrase not in linked:
        cs = content_search(phrase)
        added_cs += cs
        dbg_seeds += cs
used_lexical = False
if not dbg_seeds:
    dbg_seeds = lexical_fallback(DEBUG_QUERY, limit=5)
    used_lexical = True
best = {}
for s in dbg_seeds:
    if s[0] not in best or s[2] > best[s[0]][2]:
        best[s[0]] = s
dbg_seeds = sorted(best.values(), key=lambda s: -s[2])

print(f"\ncontent_search seeds added : {len(added_cs)}")
print(f"lexical_fallback used      : {used_lexical}")
_show(pd.DataFrame([{
