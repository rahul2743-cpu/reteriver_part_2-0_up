real_ids = [c["chunk_id"] for c in real_top]
if debug_ids == real_ids:
    print(f"OK - debug trace and rank_chunks picked the same {len(real_ids)} chunks in the same order.")
else:
    print("MISMATCH - debug trace and rank_chunks differ:")
    print("  debug      :", debug_ids)
    print("  rank_chunks:", real_ids)

