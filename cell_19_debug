_show(pd.DataFrame([{
    "term": t, "chunks_containing (DF)": DF.get(t, 0), "idf": round(idf(t), 4),
    "note": "not in any chunk" if DF.get(t, 0) == 0 else "",
} for t in sorted(dbg_terms, key=lambda t: -idf(t))]),
      "terms (higher IDF = rarer = more important)")
print(f"index: {N_CHUNKS} chunks, average length {AVG_LEN:.1f} terms")

# ----------------------------------------------------------
# 7. BM25 BREAKDOWN
# ----------------------------------------------------------
print("\n" + "=" * 80)
print("7. BM25 BREAKDOWN  (every chunk of the kept documents)")
print("=" * 80)
bm_rows = []
for d in kept_docs:
    for ch in CHUNKS_BY_DOC[d]:
        norm = BM25_K1 * (1 - BM25_B + BM25_B * ch["len"] / AVG_LEN) if AVG_LEN else BM25_K1
        parts = {}
        for t in dbg_terms:
            f = ch["tf"].get(t, 0)
            if f:
                parts[t] = (f, idf(t) * f * (BM25_K1 + 1) / (f + norm))
        bm_rows.append({
            "doc": d,
            "bm25_raw": bm25(dbg_terms, ch),
            "title": ch["title"],
            "chunk_index": ch["chunk_index"],
            "bm25": round(bm25(dbg_terms, ch), 4),
            "matched_terms": ", ".join(f"{t}(tf={f}:{s:.2f})"
                                       for t, (f, s) in sorted(parts.items(), key=lambda x: -x[1][1])),
            "chunk_len_terms": ch["len"],
            "text": ch["text"][:SHOW_TEXT],
            "chunk_id": ch["chunk_id"],
        })
bm_df = (pd.DataFrame(bm_rows).sort_values("bm25_raw", ascending=False)
         .drop(columns=["doc", "bm25_raw"]) if bm_rows else pd.DataFrame())
_show(bm_df, "BM25 per chunk (term(tf=count:contribution))")
if bm_rows:
    n_zero = int((bm_df["bm25"] == 0).sum())
    print(f"chunks with BM25 = 0 (dropped): {n_zero} of {len(bm_df)}")

# ----------------------------------------------------------
# 8. SELECTION
# ----------------------------------------------------------
print("\n" + "=" * 80)
print(f"8. SELECTION  (TOP_K = {TOP_K}, MAX_PER_DOC = {MAX_PER_DOC})")
print("=" * 80)
pool = [r for r in bm_rows if r["bm25_raw"] > 0] or [r for r in bm_rows if r["chunk_index"] == 0]
pool.sort(key=lambda r: -r["bm25_raw"])
sel_rows, per_doc, n_picked = [], Counter(), 0
for r in pool:
    if n_picked >= TOP_K:
        status = "not reached (TOP_K full)"
    elif per_doc[r["doc"]] >= MAX_PER_DOC:
        status = "skipped (MAX_PER_DOC)"
    else:
        status = "PICKED"
        per_doc[r["doc"]] += 1
        n_picked += 1
    sel_rows.append({"status": status, "title": r["title"],
                     "chunk_index": r["chunk_index"], "bm25": r["bm25"],
                     "chunk_id": r["chunk_id"]})
_show(pd.DataFrame(sel_rows), "selection walk (in BM25 order)")

# ----------------------------------------------------------
# 9. CROSS-CHECK WITH rank_chunks
# ----------------------------------------------------------
print("\n" + "=" * 80)
print("9. CROSS-CHECK  (debug trace vs Cell 17 rank_chunks)")
print("=" * 80)
real_top, real_docs = rank_chunks(DEBUG_QUERY, dbg_phrases, dbg_seeds, dbg_edges)
