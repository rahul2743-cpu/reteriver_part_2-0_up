def _label(n):
    if n in G:
        return G.nodes[n].get("label", n)
    return NODE_LABEL.get(n, n)


def _show(df, title):
    print(f"\n--- {title} ({len(df)} rows) ---")
    if len(df):
        display(df.head(MAX_ROWS))
    else:
        print("  (empty)")


print("=" * 80)
print("CELL 17-DEBUG")
