# CELL 17C - RELEVANT CHUNKS ONLY (no full-article fetch at query time)
#
# What changes vs 17A:
#   * Chunks are stored IN THE GRAPH once (build_chunk_nodes), each as an
#     ex:Chunk node with ex:chunkOf / ex:chunkIndex / ex:chunkText.
#   * At query time, fetch_relevant_chunks() asks SPARQL only for chunks whose
#     text contains a query word or phrase (plus chunk 0 for seed documents
#     that match nothing). Full document text is never fetched.
#   * retrieve_chunks is replaced, so kg_answer() (17B) uses this version.
#
# Run AFTER Cell 17A and 17B. Then call build_chunk_nodes() once
# (and again if the graph g is rebuilt in Cell 11).
# Needs: g, PREFIXES, KB_BASE, _LABEL17, _values, _tok, chunk_text,
#        CHUNK_CHARS, CHUNK_OVERLAP, CHUNKS_PER_DOC, get_seeds, traverse,
#        select_documents, query_nodes, rank_chunks_in_doc,
#        rank_chunks_global, rank_relationships
# ==============================================================================
import re
from rdflib import Literal, URIRef, RDF, Namespace, XSD

# Base URI of the graph: KB_BASE (Cell 14) -> BASE (Cell 11) -> literal default
_KG_ROOT = (globals().get("KB_BASE") or globals().get("KG_BASE")
            or globals().get("BASE") or "http://knwbt.local/kg/")
EX = Namespace(f"{_KG_ROOT}schema/")
print(f"Graph base URI: {_KG_ROOT}")
CHUNK_BUILD_MAX_CHARS = 4000   # safety cap; not used to cut text, just reported

# ------------------------------------------------------------------------------
# 1. ONE-TIME BUILD: documents -> chunk nodes in the graph
# ------------------------------------------------------------------------------
def build_chunk_nodes(size=None, overlap=None, force=False):
    """Split every ex:Document's text once and store each chunk in g.
    Documents that already have chunks are skipped unless force=True."""
    size = size or CHUNK_CHARS
    overlap = CHUNK_OVERLAP if overlap is None else overlap
    q = PREFIXES + """
    SELECT ?doc ?content WHERE {
      ?doc a ex:Document ; ex:documentContent ?content .
    }"""
    n_docs = n_chunks = n_skipped = 0
    for row in list(g.query(q)):
        doc = URIRef(str(row.doc))
        if not force and (doc, EX.hasChunk, None) in g:
            n_skipped += 1
            continue
        if force:
            for cn in list(g.objects(doc, EX.hasChunk)):
                g.remove((cn, None, None))
            g.remove((doc, EX.hasChunk, None))
            g.remove((doc, EX.chunkCount, None))
        texts = chunk_text(str(row.content), size, overlap)
        for i, t in enumerate(texts):
            cn = URIRef(f"{doc}/chunk/{i}")
            g.add((cn, RDF.type, EX.Chunk))
            g.add((cn, EX.chunkOf, doc))
            g.add((doc, EX.hasChunk, cn))
            g.add((cn, EX.chunkIndex, Literal(i, datatype=XSD.integer)))
            g.add((cn, EX.chunkText, Literal(t)))
        g.add((doc, EX.chunkCount, Literal(len(texts), datatype=XSD.integer)))
        n_docs += 1
        n_chunks += len(texts)
    print(f"Chunk nodes built: {n_chunks} chunks for {n_docs} documents "
          f"({n_skipped} already built, skipped)")
    return n_chunks

# ------------------------------------------------------------------------------
# 2. QUERY TIME: fetch only the relevant chunks
# ------------------------------------------------------------------------------
def _term_filter(terms, phrase_lc):
    """SPARQL FILTER: chunk text contains at least one query word or phrase."""
    needles = sorted({t for t in terms if t} | {p for p in phrase_lc if p})
    if not needles:
        return None
    return "FILTER(" + " || ".join(
        f"CONTAINS(LCASE(STR(?text)), {_sparql_literal(n)})" for n in needles) + ")"

def fetch_relevant_chunks(doc_uris, terms, phrase_lc, seed_docs=()):
    """{doc_uri: [chunk dict]} containing ONLY chunks that match the query,
    plus chunk 0 of seed documents that match nothing."""
    out = defaultdict(list)
    block = _values(doc_uris)
    if not block:
        return {}
    flt = _term_filter(terms, phrase_lc)
    if flt:
        q = PREFIXES + f"""
        SELECT ?doc ?idx ?text WHERE {{
          VALUES ?doc {{ {block} }}
          ?chunk ex:chunkOf ?doc ; ex:chunkIndex ?idx ; ex:chunkText ?text .
          {flt}
        }}"""
        try:
            for r in g.query(q):
                out[str(r.doc)].append((int(r.idx), str(r.text)))
        except Exception as e:
            print(f"  relevant-chunk query failed: {e}")

    # seed documents with no matching chunk -> keep their first chunk
    need0 = [u for u in seed_docs if u in set(doc_uris) and not out.get(u)]
    if need0:
        q0 = PREFIXES + f"""
        SELECT ?doc ?idx ?text WHERE {{
          VALUES ?doc {{ {_values(need0)} }}
          ?chunk ex:chunkOf ?doc ; ex:chunkIndex ?idx ; ex:chunkText ?text .
          FILTER(?idx = 0)
        }}"""
        try:
            for r in g.query(q0):
                out[str(r.doc)].append((int(r.idx), str(r.text)))
        except Exception as e:
            print(f"  seed chunk-0 query failed: {e}")

    result = {}
    for u, items in out.items():
        label = _LABEL17.get(u, u)
        n_total = _int(next(iter(g.objects(URIRef(u), EX.chunkCount)), 0))
        chunks = [{"doc_uri": u, "doc_label": label, "index": i, "n_chunks": n_total,
                   "text": t, "tokens": _tok(label + " " + t)}
                  for i, t in sorted(items)]
        result[u] = chunks
    return result

# ------------------------------------------------------------------------------
# 3. Candidate selection (same rules as 17A A4, on relevant chunks only)
# ------------------------------------------------------------------------------
def _pick_relevant(question, phrases, docs, chunk_map):
    terms, phrase_lc = query_nodes(question, phrases)
    candidates, per_doc = [], {}
    for u, d in docs.items():
        chunks = chunk_map.get(u, [])
        if not chunks:
            continue
        pr, hits, iters = rank_chunks_in_doc(chunks, terms, phrase_lc)
        relevant = [c for c in chunks if hits[c["index"]] > 0]
        if relevant:
            keep = sorted(relevant, key=lambda c: -pr[c["index"]])[:CHUNKS_PER_DOC]
        else:
            keep = chunks[:1] if d["is_seed"] else []
        best = max((pr[c["index"]] for c in keep), default=0.0) or 1.0
        for c in keep:
            cand = dict(c)
            cand.update(id=f"{u}#{c['index']}", hop=d["hop"], is_seed=d["is_seed"],
                        local_pr=pr[c["index"]] / best, query_hits=hits[c["index"]])
            candidates.append(cand)
        per_doc[u] = (len(chunks), len(keep), iters)
    return candidates, per_doc, (terms, phrase_lc)

# ------------------------------------------------------------------------------
# 4. Replacement retrieve_chunks (graph -> subgraph -> relevant chunks -> rank)
# ------------------------------------------------------------------------------
_retrieve_chunks_full = globals().get("_retrieve_chunks_full", retrieve_chunks)   # keep the 17A version (safe on re-run)

def retrieve_chunks_relevant(question, verbose=True):
    phrases, seeds, fallback = get_seeds(question, verbose)
    res = {"question": question, "phrases": phrases, "seeds": seeds, "fallback_used": fallback,
           "edges": [], "docs": {}, "texts": {}, "candidates": [], "ranked_chunks": [],
           "relationships": []}
    if not seeds:
        if verbose:
            print("  no seeds - nothing to retrieve")
        return res

    edges, visited = traverse(seeds)                                   # graph walk, no text
    docs, doc_links = select_documents(seeds, edges, visited)          # which documents
    terms, phrase_lc = query_nodes(question, phrases)
    seed_docs = {u for u, d in docs.items() if d["is_seed"]}
    chunk_map = fetch_relevant_chunks(list(docs), terms, phrase_lc, seed_docs)   # ONLY relevant chunks
    candidates, per_doc, query = _pick_relevant(question, phrases, docs, chunk_map)
    subgraph_nodes = {str(k) for k in visited} | set(docs) | {s[0] for s in seeds}
    ranked, adj, iters = rank_chunks_global(candidates, seeds, doc_links,
                                            subgraph_nodes, query)     # A5 (unchanged)

    texts = {u: {"label": _LABEL17.get(u, u), "content": None} for u in docs}  # label only
    res.update(edges=edges, docs=docs, texts=texts, candidates=candidates,
               ranked_chunks=ranked, relationships=rank_relationships(edges, seeds),
               chunk_graph=adj, pr_iterations=iters)
    if verbose:
        print(f"\nQ : {question}")
        print(f"  seeds     : {[(l, round(s, 1)) for _, l, s, _ in seeds]}"
              + ("  (FALLBACK)" if fallback else ""))
        print(f"  edges     : {len(edges)}   documents in subgraph: {len(docs)}   "
              f"documents with relevant chunks: {len(chunk_map)}")
        print(f"  relevant chunks fetched: {sum(len(v) for v in chunk_map.values())}   "
              f"kept after ranking: {len(ranked)}")
        for c in ranked[:10]:
            print(f"    {c['score']:.3f}  PR={c['pagerank']:.4f} hop={c['hop']} "
                  f"{c['doc_label'][:45]} #{c['index']}")
    return res

