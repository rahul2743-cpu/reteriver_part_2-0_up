# CELL 18 - PYVIS VISUALIZATION: QUERY -> SEEDS -> HOPS -> RELEVANT CHUNKS
#
# Draws, for ONE question:
#   * QUERY node (black star)
#   * seed nodes  (hop 0, red)      -- documents = boxes, entities = dots
#   * hop-1 nodes (orange), hop-2 nodes (green)
#   * traversal edges (label = predicate, thickness = strength, hover = description)
#   * relevant chunks kept after ranking (blue), attached to their document;
#     size = ranking score; chunks actually sent to the LLM are purple
#   * optional: query-word nodes linking QUERY -> word -> chunk (show_terms=True)
#
# Usage (Databricks):
#   %pip install pyvis          <- once, in its own cell
#   ans  = kg_answer(QUERY, verbose=False)              # or retrieve_chunks(QUERY)
#   html = visualize_query_graph(ans["retrieval"], answer=ans)
#   displayHTML(html)
#
# Works with both the 17A retriever and the 17C relevant-chunks retriever.
# ==============================================================================
import html as _html
from pyvis.network import Network

HOP_COLORS   = {0: "#d62728", 1: "#ff7f0e", 2: "#2ca02c"}
QUERY_COLOR  = "#222222"
CHUNK_COLOR  = "#1f77b4"
CHOSEN_COLOR = "#9467bd"
TERM_COLOR   = "#bbbbbb"


def _short(s, n=40):
    s = str(s)
    return s if len(s) <= n else s[:n - 1] + "…"


def _tip(*lines):
    """Hover text (plain text, escaped)."""
    return "\n".join(_html.escape(str(l)) for l in lines if l is not None)


_LEGEND = """
<div style="position:fixed;top:10px;left:10px;z-index:999;background:#fff;
            border:1px solid #ccc;padding:8px 12px;font:12px sans-serif;line-height:1.7">
  <b>Legend</b><br>
  <span style="color:#222">&#9733;</span> Query<br>
  <span style="color:#d62728">&#9632;</span> Hop 0 (seed)
  <span style="color:#ff7f0e">&#9632;</span> Hop 1
  <span style="color:#2ca02c">&#9632;</span> Hop 2<br>
  &#9645; box = document &nbsp; &#9679; dot = entity<br>
  <span style="color:#1f77b4">&#9670;</span> relevant chunk (size = score)<br>
  <span style="color:#9467bd">&#9670;</span> chunk sent to the LLM
</div>
"""


def visualize_query_graph(res, answer=None, max_edges=150, max_chunks=30,
                          show_terms=False, out_path="/tmp/kg_query_graph.html",
                          height="850px"):
    """res    = dict from retrieve_chunks(...)   (or kg_answer(...)["retrieval"])
       answer = dict from kg_answer(...)  -> marks the chunks sent to the LLM
       Returns the HTML string (use displayHTML(html) in Databricks)."""
    net = Network(height=height, width="100%", directed=True,
                  bgcolor="#ffffff", font_color="#222222", cdn_resources="in_line")
    net.barnes_hut(gravity=-9000, central_gravity=0.25, spring_length=150)

    content_nodes = globals().get("CONTENT_NODES") or set(res.get("texts", {}))
    content_nodes = {str(n) for n in content_nodes}
    chosen = {c["id"] for c in (answer or {}).get("top_chunks", [])}

    # ---- labels + hop of every node ---------------------------------------
    labels, hop_of, seed_score = {}, {}, {}
    for n, l, s, p in res["seeds"]:
        labels[n], hop_of[n], seed_score[n] = l, 0, (s, p)
    edges = sorted(res["edges"], key=lambda e: (e["hop"], -e["strength"]))[:max_edges]
    for e in edges:
        for side in ("source", "target"):
            labels.setdefault(e[side], e[f"{side}_label"])
            hop_of.setdefault(e[side], e["hop"])
    for u, d in res.get("docs", {}).items():
        labels.setdefault(u, res.get("texts", {}).get(u, {}).get("label", u))
        hop_of.setdefault(u, d["hop"])

    # ---- QUERY node ---------------------------------------------------------
    net.add_node("QUERY", label=_short(res["question"], 60), shape="star", size=40,
                 color=QUERY_COLOR, title=_tip("QUERY", res["question"],
                 "entities: " + ", ".join(p for p, _ in res.get("phrases", []))))

    # ---- graph nodes (seeds, hop 1, hop 2) -------------------------------
    for n, lbl in labels.items():
        hop = min(int(hop_of.get(n, 2)), 2)
        is_doc = n in content_nodes
        doc_info = res.get("docs", {}).get(n, {})
        tip = [lbl, f"hop {hop}", "document" if is_doc else "entity"]
        if n in seed_score:
            tip.append(f"seed score {seed_score[n][0]:.0f} via '{seed_score[n][1]}'")
        if doc_info:
            tip.append(f"selected document (evidence {doc_info.get('evidence', 0):.2f})")
        net.add_node(n, label=_short(lbl), title=_tip(*tip),
                     shape="box" if is_doc else "dot",
                     color=HOP_COLORS[hop],
                     size=30 if hop == 0 else (20 if hop == 1 else 14),
                     borderWidth=3 if doc_info else 1,
                     font={"color": "#ffffff" if is_doc else "#222222"})

    # ---- QUERY -> seed edges -----------------------------------------------
    for n, l, s, p in res["seeds"]:
        net.add_edge("QUERY", n, label=f"seed {s:.0f}", color="#888888",
                     dashes=True, width=2, title=_tip(f"matched phrase: {p}"))

    # ---- traversal edges -----------------------------------------------------
    for e in edges:
        net.add_edge(e["source"], e["target"],
                     label=_short(e["predicate"], 25),
                     width=1 + e["strength"] / 2.5,
                     color=HOP_COLORS[min(int(e["hop"]), 2)],
                     title=_tip(f"{e['source_label']} --[{e['predicate']}, "
                                f"strength {e['strength']}, hop {e['hop']}]--> {e['target_label']}",
                                e["description"]))

    # ---- relevant chunks (after ranking) ----------------------------------
    ranked = res.get("ranked_chunks", [])[:max_chunks]
    for c in ranked:
        cid = f"chunk::{c['id']}"
        doc = c["doc_uri"]
        if doc not in labels:                      # doc not drawn yet
            labels[doc] = c["doc_label"]
            net.add_node(doc, label=_short(c["doc_label"]), shape="box",
                         color=HOP_COLORS[min(int(c.get("hop", 2)), 2)],
                         font={"color": "#ffffff"})
        is_chosen = c["id"] in chosen
        net.add_node(cid, label=f"#{c['index']}  {c['score']:.2f}",
                     shape="diamond", size=8 + 22 * c["score"],
                     color=CHOSEN_COLOR if is_chosen else CHUNK_COLOR,
                     title=_tip(f"{c['doc_label']}  chunk #{c['index']}",
                                f"score {c['score']:.3f}   PageRank {c['pagerank']:.4f}   "
                                f"query hits {c.get('query_hits', '?')}",
                                "SENT TO LLM" if is_chosen else "",
                                "-" * 40, c["text"][:500]))
        net.add_edge(doc, cid, color=CHOSEN_COLOR if is_chosen else CHUNK_COLOR,
                     dashes=True, width=1, title="chunk of")

    # ---- optional: QUERY -> word -> chunk ---------------------------------
    if show_terms and ranked and "query_nodes" in globals():
        terms, phrase_lc = query_nodes(res["question"], res.get("phrases", []))
        for t in sorted(terms) + list(phrase_lc):
            tid = f"term::{t}"
            hits = [c for c in ranked
                    if (t in c.get("tokens", []) if " " not in t else t in c["text"].lower())]
            if not hits:
                continue
            net.add_node(tid, label=t, shape="ellipse", color=TERM_COLOR, size=10)
            net.add_edge("QUERY", tid, color=TERM_COLOR, width=1)
            for c in hits:
                net.add_edge(tid, f"chunk::{c['id']}", color=TERM_COLOR, width=1)

    html = net.generate_html()
    html = html.replace("<body>", "<body>" + _LEGEND, 1)
    with open(out_path, "w", encoding="utf-8") as f:
        f.write(html)
    print(f"Graph: {len(net.nodes)} nodes, {len(net.edges)} edges "
          f"({len(ranked)} chunks, {len(chosen)} sent to LLM) -> {out_path}")
    return html


